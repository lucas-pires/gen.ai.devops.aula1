{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.5-flash",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    { "action": "read", "resource": "*.tfstate", "effect": "deny" },
    { "action": "read", "resource": "*.tfstate.*", "effect": "deny" },
    { "action": "read", "resource": "*.tfvars", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },

    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "terraform apply*", "effect": "deny" },
    { "action": "shell", "resource": "terraform destroy*", "effect": "deny" },
    { "action": "shell", "resource": "aws *", "effect": "deny" },
    { "action": "shell", "resource": "env*", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },

    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" }
  ]
}
